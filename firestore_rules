rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isLoggedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if isLoggedIn();
      allow create: if request.auth.uid == uid;
      allow update: if request.auth.uid == uid || isAdmin();
      allow delete: if isAdmin();
    }

    match /rides/{rideId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.driverId == request.auth.uid;
      allow update: if isLoggedIn() && (resource.data.driverId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isLoggedIn() && (
        resource.data.passengerId == request.auth.uid ||
        get(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.driverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isLoggedIn() && request.resource.data.passengerId == request.auth.uid;
      allow update: if isLoggedIn() && (
        resource.data.passengerId == request.auth.uid ||
        get(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.driverId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /chats/{rideId} {
      allow read, write: if isLoggedIn();
      match /messages/{messageId} {
        allow read: if isLoggedIn();
        allow create: if isLoggedIn() && request.resource.data.senderId == request.auth.uid;
        allow delete: if isLoggedIn() && (resource.data.senderId == request.auth.uid || isAdmin());
        allow update: if false;
      }
    }

    match /ratings/{ratingId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.raterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read, update, delete: if isLoggedIn() && resource.data.userId == request.auth.uid;
      allow create: if isLoggedIn();
    }
  }
}